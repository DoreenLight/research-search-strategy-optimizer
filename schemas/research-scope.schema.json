{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "research-scope.schema.json", "type": "object",
  "required": ["schema_version", "scope_id", "description", "mode", "research_object", "input_modality", "research_task", "method", "application", "constraints", "unspecified"],
  "properties": {
    "schema_version": {"const": "0.1"}, "scope_id": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "mode": {"enum": ["exploratory", "systematic_preparation"]},
    "research_object": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "input_modality": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "research_task": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "method": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "application": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "constraints": {"type": "object", "properties": {
      "date_from": {"type": "string", "format": "date"}, "date_to": {"type": "string", "format": "date"},
      "language": {"type": "string", "pattern": "^[a-z]{2}$"}
    }, "additionalProperties": false},
    "unspecified": {"type": "array", "items": {"type": "string"}}
  }, "additionalProperties": false
}
