{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "search-run.schema.json", "type": "object",
  "required": ["schema_version", "run_id", "plan_id", "status", "returned_count", "fetched_count", "deduplicated_count", "request_count", "paper_ids", "raw_path", "attempts", "warnings", "mode", "estimated_cost_usd"],
  "properties": {
    "schema_version": {"const": "0.1"}, "run_id": {"type": "string", "minLength": 1}, "plan_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["planned", "success", "partial", "failed", "not_executed"]},
    "returned_count": {"type": ["integer", "null"], "minimum": 0}, "fetched_count": {"type": "integer", "minimum": 0},
    "deduplicated_count": {"type": "integer", "minimum": 0}, "request_count": {"type": "integer", "minimum": 0},
    "started_at": {"type": ["string", "null"], "format": "date-time"}, "finished_at": {"type": ["string", "null"], "format": "date-time"},
    "request_url": {"type": ["string", "null"]}, "error_type": {"type": ["string", "null"]}, "error_message": {"type": ["string", "null"]},
    "paper_ids": {"type": "array", "items": {"type": "string"}}, "raw_path": {"type": ["string", "null"]},
    "attempts": {"type": "array", "items": {"type": "object"}}, "warnings": {"type": "array", "items": {"type": "string"}},
    "mode": {"enum": ["planned", "live", "replay"]}, "estimated_cost_usd": {"type": ["number", "null"], "minimum": 0},
    "cache_hit": {"type": "boolean"}, "cache_key": {"type": ["string", "null"]}, "metadata_bytes": {"type": "integer", "minimum": 0}
  }, "additionalProperties": false
}
